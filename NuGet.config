<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Key must match packageSourceMapping exactly (case-sensitive).
         MSBuild/NuGet on Windows often surface this feed as "Nuget.org";
         a mismatch yields NU1100: sources were not considered. -->
    <add key="Nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="react-native" value="https://pkgs.dev.azure.com/ms/react-native/_packaging/react-native-public/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="react-native">
      <package pattern="Microsoft.ReactNative*" />
      <package pattern="Microsoft.JavaScript.Hermes" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
