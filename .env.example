# Shared secrets / API endpoints. Pick a file via GUMP_ENV when building:
#   prod    → .env           (npm run build:macos / build:windows)
#   local   → .env.local     (npm run macos / npm start / npm run windows)
#   staging → .env.staging   (npm run build:macos:staging / build:windows:staging)
#
# APP_BUILD_ID is forced from GUMP_ENV (prod | local | staging).
# APP_VERSION is per platform (do not set here):
#   macos   → VERSION.macos
#   windows → VERSION.windows
# GIT_SHA is resolved from `git rev-parse --short HEAD` at build/run time.
#
# Windows examples:
#   npm run build:windows:staging
#   npm run build:windows:zip -- staging
#   set GUMP_ENV=staging&& npm run build:windows:zip
# Artifacts → dist/<env>/windows/

# API base URL (no trailing slash)
API_BASE_URL=https://api.gump-staging.net

# PostHog error tracking (leave POSTHOG_API_KEY empty to disable)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Local development (.env.local):
# API_BASE_URL=http://localhost:3000

# macOS distribution (npm run build:macos:distribute)
# MACOS_CODESIGN_IDENTITY="Developer ID Application: Gump Ai Limited (FWQ2YTUNN4)"
# APPLE_TEAM_ID=FWQ2YTUNN4
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Or use App Store Connect API key instead of Apple ID:
# APPLE_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
