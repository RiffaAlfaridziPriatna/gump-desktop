require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

# New Architecture disabled on macOS — Fabric registration crashes when
# codegen lists components (e.g. react-native-screens) with no macOS native module.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

target 'GumpDesktop-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  # ONNX Runtime C API for shared SCRFD + OCEC face detection pipeline
  pod 'onnxruntime-c', '~> 1.20'

  # Silent auto-update (sandboxed apps need Sparkle 2.x + InstallerLauncher XPC)
  pod 'Sparkle', '~> 2.6'

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # Xcode 27+ only supports MACOSX_DEPLOYMENT_TARGET >= 12.0. Some pods
    # (notably RNSVG-RNSVGFilters) still declare 10.14 and fail the build.
    min_macos = Gem::Version.new('12.0')
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['MACOSX_DEPLOYMENT_TARGET']
        next if current.nil? || current.empty?
        if Gem::Version.new(current) < min_macos
          config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = min_macos.to_s
        end
      end
    end

    system('ruby', File.join(__dir__, 'scripts', 'patch_secure_text_field.rb'))
    system('ruby', File.join(__dir__, 'scripts', 'patch_third_party_fabric_components.rb'))
    system('ruby', File.join(__dir__, 'scripts', 'patch_fmt_consteval.rb'))
  end
end
